# FreshFlow OS - AI service configuration
# Copy this file to .env and fill in values. NEVER commit the real .env file.

# Which provider to use: ollama | gemini | glm
AI_PROVIDER=ollama

# --- Ollama (local, free, no key needed) ---
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# --- Gemini (free tier, requires API key) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- GLM / Zhipu AI (has a free tier, requires API key) ---
# Get a key at https://open.bigmodel.cn
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# --- Embeddings (local, no key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LOG_LEVEL=INFO
